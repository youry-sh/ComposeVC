{
  "manifest_version": 3,
  "name": "ANTI Speech Locale",
  "version": "1.1.0",
  "description": "Filter speechSynthesis.getVoices() to match persona language (mitigation until C++ patch 019).",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://hcaptcha.com/*",
        "*://*.newassets.hcaptcha.com/*",
        "*://www.google.com/recaptcha/*",
        "*://www.recaptcha.net/*",
        "*://recaptcha.net/*",
        "*://*.recaptcha.net/*",
        "*://www.gstatic.com/recaptcha/*",
        "*://*.stripe.com/*",
        "*://stripe.com/*",
        "*://*.stripe.network/*",
        "*://*.stripecdn.com/*",
        "*://*.paypal.com/*",
        "*://*.paypalobjects.com/*",
        "*://*.braintreegateway.com/*",
        "*://*.braintree-api.com/*",
        "*://*.adyen.com/*",
        "*://*.adyenpayments.com/*",
        "*://pay.google.com/*",
        "*://*.payments.google.com/*",
        "*://*.squareup.com/*",
        "*://*.squarecdn.com/*",
        "*://*.klarna.com/*",
        "*://*.klarnacdn.net/*",
        "*://*.checkout.com/*",
        "*://*.cardinalcommerce.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
