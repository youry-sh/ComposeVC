{
  "manifest_version": 3,
  "name": "ANTI Captcha Helper",
  "version": "1.3.0",
  "description": "Auto-solve Turnstile / reCAPTCHA / hCaptcha via ANTI UI. Auto-injects and soft-reloads tabs so no manual Reload banner click is required.",
  "permissions": ["storage", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://hcaptcha.com/*",
        "*://*.newassets.hcaptcha.com/*",
        "*://www.google.com/recaptcha/*",
        "*://www.recaptcha.net/*",
        "*://recaptcha.net/*",
        "*://*.recaptcha.net/*",
        "*://www.gstatic.com/recaptcha/*",
        "*://*.stripe.com/*",
        "*://stripe.com/*",
        "*://*.stripe.network/*",
        "*://*.stripecdn.com/*",
        "*://*.paypal.com/*",
        "*://*.paypalobjects.com/*",
        "*://*.braintreegateway.com/*",
        "*://*.braintree-api.com/*",
        "*://*.adyen.com/*",
        "*://*.adyenpayments.com/*",
        "*://pay.google.com/*",
        "*://*.payments.google.com/*",
        "*://*.squareup.com/*",
        "*://*.squarecdn.com/*",
        "*://*.klarna.com/*",
        "*://*.klarnacdn.net/*",
        "*://*.checkout.com/*",
        "*://*.cardinalcommerce.com/*",
        "*://*.3ds.mastercard.com/*",
        "*://*.secure.checkout.visa.com/*",
        "*://*.acs.visa.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://hcaptcha.com/*",
        "*://*.newassets.hcaptcha.com/*",
        "*://www.google.com/recaptcha/*",
        "*://www.recaptcha.net/*",
        "*://recaptcha.net/*",
        "*://*.recaptcha.net/*",
        "*://www.gstatic.com/recaptcha/*",
        "*://*.stripe.com/*",
        "*://stripe.com/*",
        "*://*.stripe.network/*",
        "*://*.stripecdn.com/*",
        "*://*.paypal.com/*",
        "*://*.paypalobjects.com/*",
        "*://*.braintreegateway.com/*",
        "*://*.braintree-api.com/*",
        "*://*.adyen.com/*",
        "*://*.adyenpayments.com/*",
        "*://pay.google.com/*",
        "*://*.payments.google.com/*",
        "*://*.squareup.com/*",
        "*://*.squarecdn.com/*",
        "*://*.klarna.com/*",
        "*://*.klarnacdn.net/*",
        "*://*.checkout.com/*",
        "*://*.cardinalcommerce.com/*",
        "*://*.3ds.mastercard.com/*",
        "*://*.secure.checkout.visa.com/*",
        "*://*.acs.visa.com/*"
      ],
      "js": ["hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_about_blank": true
    }
  ]
}
