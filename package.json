{
  "name": "composevc",
  "private": true,
  "version": "1.0.5",
  "description": "ComposeVC — AI IDE with ANTI fingerprint browser",
  "author": "ComposeVC",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "build:web": "tsc && vite build",
    "build:web:dist": "vite build",
    "build:app": "tsc && vite build && node scripts/run-electron.cjs .",
    "app": "vite build && node scripts/run-electron.cjs .",
    "runtime": "node scripts/run-electron.cjs electron/runtimeMain.cjs",
    "preview": "vite preview",
    "proxy": "node electron/proxy/standalone.cjs",
    "dist": "node scripts/package-dist.mjs",
    "dist:dir": "node scripts/package-dist.mjs --dir",
    "dist:skip-web": "node scripts/package-dist.mjs --skip-web",
    "dist:light": "node scripts/package-dist.mjs --light-harden",
    "harden": "node scripts/harden-electron.mjs",
    "package": "node scripts/package-dist.mjs",
    "publish:update": "node scripts/publish-update.mjs",
    "publish:update:minor": "node scripts/publish-update.mjs --bump minor",
    "publish:update:major": "node scripts/publish-update.mjs --bump major",
    "watch:publish": "node scripts/watch-publish.mjs",
    "hotkey": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hotkey-publish.ps1",
    "hotkey:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/hotkey-publish.ps1 -InstallStartup",
    "test:tools": "node tests/tools/ultra-tools.test.cjs",
    "test:notes": "node tests/notes/notesStore.test.cjs",
    "test:knowledge-archive": "node tests/knowledge/knowledgeArchive.test.cjs",
    "test:edit-file": "node tests/edit-file.test.cjs",
    "test:rotation": "node tests/proxy/rotation.stress.test.cjs",
    "test:code-impact": "node tests/codeImpact/codeImpact.engine.test.cjs",
    "test:code-impact-ide": "node tests/codeImpact/codeImpact.engine.test.cjs",
    "test:proxy-parallel": "node tests/proxy/parallel-routing.test.cjs",
    "test:mcp": "node tests/mcp.test.cjs",
    "test:local-agent-mcp": "node tests/local-agent-mcp.smoke.test.cjs",
    "test:custom-tools-prompt": "node tests/custom-tools-prompt.test.cjs",
    "test:custom-tools-search": "node tests/custom-tools-search.test.cjs",
    "test:system-prompt": "node tests/system-prompt-efficiency.test.cjs",
    "test:compact": "node tests/compact-memory.test.cjs",
    "test:stream": "node tests/stream-performance.test.cjs",
    "test:web-engine": "node tests/web-engine/webEngineStore.test.cjs && node tests/web-engine/webEngineUrl.test.cjs && node tests/web-engine/webEngineTools.test.cjs",
    "test:prompts": "node tests/prompts/promptsStore.test.cjs",
    "test:proxy-server-retry": "node tests/proxy-server-retry.test.cjs",
    "test:vm": "node tests/vm/iso.test.cjs && node tests/vm/engine.test.cjs && node tests/vm/protocol.test.cjs && node tests/vm/download.test.cjs",
    "test:usage": "node tests/usage/usageStore.test.cjs",
    "test:neural-graph": "node tests/neural-graph.smoke.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.6.0",
    "@ngrok/ngrok": "^1.7.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.11",
    "gpt-tokenizer": "^3.4.0",
    "iconv-lite": "^0.7.3",
    "impers": "^0.0.9",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.378.0",
    "node-pty": "^1.1.0",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "telegram": "^2.26.22",
    "teleproto": "^1.228.4",
    "three": "^0.170.0",
    "typescript": "^5.5.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^42.5.1",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.3"
  },
  "build": {
    "appId": "com.composevc.app",
    "productName": "ComposeVC",
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "win": {
      "icon": "build-assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "mcp-agent",
        "to": "mcp-agent",
        "filter": [
          "**/*",
          "!.venv/**",
          "!__pycache__/**",
          "!.backup/**",
          "!*.log",
          "!.env",
          "!approved_zones.json"
        ]
      }
    ]
  }
}
