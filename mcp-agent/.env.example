# Скопируй этот файл в `.env` и впиши свой токен:
#   Mac/Linux:  cp .env.example .env
#   Windows:    copy .env.example .env
#
# Сгенерировать токен:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

MCP_TOKEN=CHANGE_ME_generate_a_long_random_token

# Публичный адрес твоего сервера (после настройки туннеля).
# Нужен вотчдогу для самопроверки. Пример: https://mcp.example.com
# PUBLIC_URL=

# Для быстрого бесплатного туннеля ничего указывать не надо.
# Для именованного Cloudflare-туннеля (свой домен):
# TUNNEL_NAME=mcp-pc
